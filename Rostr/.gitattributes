# Normalise line endings so the repo does not fill up with whitespace-only diffs.
* text=auto

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.md      text eol=lf

# Windows scripts must stay CRLF to run reliably
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.ico     binary
