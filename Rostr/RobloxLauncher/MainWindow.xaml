<Window x:Class="RobloxLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:RobloxLauncher"
        StateChanged="Window_StateChanged"
        Title="Rostr" Width="1100" Height="740" MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThText}" FontFamily="Segoe UI">

    <!-- Own title bar: the Windows one is removed, the buttons live inside the app -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText2}"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3D6BFF" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource ThAccent}"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,11">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThTrack}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                CornerRadius="10" Padding="8,6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="24">
                            <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="20" Height="20" Fill="White"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" VerticalAlignment="Center" Height="24">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Background="{DynamicResource ThAccent}"
                                              Style="{StaticResource SliderTrackButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="{DynamicResource ThTrack}"
                                              Style="{StaticResource SliderTrackButton}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollTrackBtn" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ThDisabled}" CornerRadius="4" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollTrackBtn}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollTrackBtn}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pushes the scroll bar out into the page margin so it sits next to the window edge.
             The padding gives the content the same width it had before. -->
        <Style x:Key="EdgeScroll" TargetType="ScrollViewer">
            <Setter Property="Margin" Value="0,0,-24,0"/>
            <Setter Property="Padding" Value="0,0,24,0"/>
        </Style>

        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThTrack}" BorderThickness="1"
                                CornerRadius="10" Padding="4" MinWidth="250">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{DynamicResource ThAccent}" FontSize="13" VerticalAlignment="Center"
                                           Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource ThTrack}" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch: replaces the old On/Off buttons -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Background="{DynamicResource ThTrack}" CornerRadius="13">
                            <Ellipse x:Name="thumb" Width="20" Height="20" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource ThAccent}"/>
                                <Setter TargetName="thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs on the settings page -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A button with no look of its own; the content draws everything (preset cards) -->
        <Style x:Key="BareButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.86"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
        </Style>

        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource ThMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="CardHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
        </Style>

        <DataTemplate x:Key="PresetCard">
            <Button Style="{StaticResource BareButton}" Tag="{Binding Id}" Click="Preset_Click"
                    Margin="0,0,8,8">
                <Border Background="{Binding CardBrush}" BorderBrush="{Binding EdgeBrush}"
                        BorderThickness="1.5" CornerRadius="12" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThText}"/>
                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#8A92A7"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding PillBrush}" CornerRadius="9"
                                Padding="9,2" VerticalAlignment="Top" Margin="10,0,0,0">
                            <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SearchCard">
            <Border Background="{DynamicResource ThBg2}" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="10" Background="{Binding IconBrush}"
                            VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource ThMuted}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Open" Tag="{Binding PlaceId}" Click="SearchOpen_Click"
                                FontSize="12" Padding="14,7" Margin="0,0,6,0"/>
                        <Button Content="Random" Tag="{Binding PlaceId}" Click="SearchRandom_Click"
                                FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="LibCard">
            <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                    BorderThickness="1" CornerRadius="14" Margin="6,0,6,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Height="124" CornerRadius="13,13,0,0" Background="{Binding IconBrush}"/>
                        <Border Height="60" VerticalAlignment="Bottom" CornerRadius="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#99000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,10,8"
                                Background="#B0000000" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{Binding Playtime}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Tag="{Binding PlaceId}" Click="LibStar_Click" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Margin="0,8,8,0" Padding="8,6" Background="#99000000">
                            <TextBlock Text="{Binding StarGlyph}" FontFamily="{StaticResource Icons}"
                                       FontSize="14" Foreground="{Binding StarBrush}"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="12,10,12,12">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource ThText}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource ThMuted}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Play" Tag="{Binding PlaceId}" Click="LibPlay_Click"
                                    FontSize="12" Padding="0,7" Margin="0,0,6,0" Background="#2FBF71"/>
                            <Button Grid.Column="1" Content="Servers" Tag="{Binding PlaceId}" Click="LibServers_Click"
                                    FontSize="12" Padding="10,7" Margin="0,0,6,0" Background="{DynamicResource ThDim}"/>
                            <Button Grid.Column="2" Content="Rejoin" Tag="{Binding PlaceId}" Click="LibRejoin_Click"
                                    Visibility="{Binding RejoinVisibility}"
                                    FontSize="12" Padding="10,7"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MediaCard">
            <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                    BorderThickness="1" CornerRadius="14" Margin="6,0,6,12">
                <StackPanel>
                    <Button Style="{StaticResource BareButton}" Tag="{Binding FullPath}" Click="MediaOpen_Click">
                        <Grid Height="118">
                            <Border CornerRadius="13,13,0,0" Background="{DynamicResource ThDim}"/>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="30"
                                       Foreground="{DynamicResource ThFaint}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}"/>
                            <Border CornerRadius="13,13,0,0" Background="{Binding ThumbBrush}"/>
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="16"
                                       Foreground="#F5B83D" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Margin="9,8,0,0" Visibility="{Binding StarVisibility}">
                                <TextBlock.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="4" Opacity="0.9"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <Border Width="44" Height="44" CornerRadius="22" Background="#99000000"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding PlayVisibility}">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="18"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Border>
                        </Grid>
                    </Button>
                    <StackPanel Margin="12,9,12,11">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource ThMuted}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FriendCard">
            <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}" BorderThickness="1"
                    CornerRadius="14" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="50" Height="50" VerticalAlignment="Center">
                        <Ellipse Fill="{DynamicResource ThDim}"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ThText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Handle}" FontSize="12" Foreground="{DynamicResource ThFaint}"
                                       Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="{Binding StatusBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Join" Tag="{Binding UserId}" Click="FriendJoin_Click"
                            Visibility="{Binding JoinVisibility}" FontSize="12.5" Padding="22,9" Background="#2FBF71"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowBorder" BorderBrush="{DynamicResource ThDim}" BorderThickness="1">
    <Grid>
        <Image x:Name="BgImage" Stretch="UniformToFill" Opacity="0.14" IsHitTestVisible="False"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource ThBg2}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,8,0,28">
                        <Border Width="42" Height="42" CornerRadius="12">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Rostr" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="Launcher" FontSize="12" Foreground="{DynamicResource ThMuted}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="NavPlayBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavPlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Play"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLibraryBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavLibrary_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Library"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavTrendingBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavTrending_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Trending"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFriendsBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavFriends_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Friends"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavMediaBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavMedia_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE722;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Gallery"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavReadmeBtn" Style="{StaticResource NavButton}"
                                Margin="0,0,0,6" Click="NavReadme_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE736;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Open README"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavWebBtn" Style="{StaticResource NavButton}"
                                Click="NavWeb_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource Icons}" Width="26"/>
                                <TextBlock Text="Open web"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <Button x:Name="AccountBtn" Margin="0,0,0,8" Background="{DynamicResource ThDim}"
                                HorizontalContentAlignment="Left" Click="AccountBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountGlyph" Text="&#xE77B;" FontFamily="{StaticResource Icons}"
                                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="AccountAvatar" Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="AccountBtnText" Text="Browser login"
                                           TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenRobloxBtn" Click="OpenRobloxBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" Margin="0,0,10,0"/>
                                <TextBlock Text="Open Roblox"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="4" Background="{DynamicResource ThCard}" CornerRadius="10" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#F5B83D"
                                     VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting..."
                                       Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource ThText2}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <Grid Grid.Column="1" Margin="28,44,28,24">

                <!-- PLAY PAGE -->
                <Grid x:Name="PlayPage">

                    <ScrollViewer x:Name="EmptyState" Style="{StaticResource EdgeScroll}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="0,8,0,8">
                            <StackPanel x:Name="EmptyHero">
                                <Border Width="92" Height="92" CornerRadius="24" HorizontalAlignment="Center"
                                        Margin="0,0,0,18">
                                    <Border.Background>
                                        <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill"/>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#3D6BFF" Opacity="0.45" BlurRadius="44" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="Ready to play" FontSize="32" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Search for a game below, or press Play on roblox.com and it opens here first, so you can pick a server before joining."
                                           Foreground="{DynamicResource ThMuted}" FontSize="14" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="20,10,20,22"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource BareButton}" Click="NavLibrary_Click" Margin="0,0,8,0" Cursor="Hand">
                                        <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                                BorderThickness="1" CornerRadius="14" Padding="14,12">
                                            <StackPanel>
                                                <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                                        Background="{DynamicResource ThAccentBg}">
                                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" FontSize="15"
                                                               Foreground="{DynamicResource ThAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Library" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThText}" Margin="0,10,0,0"/>
                                                <TextBlock Text="Favorites, recent games and playtime." FontSize="11.5" Foreground="{DynamicResource ThMuted}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource BareButton}" Click="NavFriends_Click" Margin="4,0,4,0" Cursor="Hand">
                                        <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                                BorderThickness="1" CornerRadius="14" Padding="14,12">
                                            <StackPanel>
                                                <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                                        Background="{DynamicResource ThAccentBg}">
                                                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="15"
                                                               Foreground="{DynamicResource ThAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Friends" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThText}" Margin="0,10,0,0"/>
                                                <TextBlock Text="Join a friend in their game." FontSize="11.5" Foreground="{DynamicResource ThMuted}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource BareButton}" Click="OpenRobloxBtn_Click" Margin="8,0,0,0" Cursor="Hand">
                                        <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                                BorderThickness="1" CornerRadius="14" Padding="14,12">
                                            <StackPanel>
                                                <Border Width="34" Height="34" CornerRadius="10" HorizontalAlignment="Left"
                                                        Background="{DynamicResource ThAccentBg}">
                                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="15"
                                                               Foreground="{DynamicResource ThAccent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Roblox website" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource ThText}" Margin="0,10,0,0"/>
                                                <TextBlock Text="Browse games on roblox.com." FontSize="11.5" Foreground="{DynamicResource ThMuted}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                    BorderThickness="1" CornerRadius="16" Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                   Foreground="{DynamicResource ThAccent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="FIND A GAME" Foreground="{DynamicResource ThMuted}" FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="PlaceBox" FontSize="14" TextAlignment="Left"
                                                     TextChanged="PlaceBox_TextChanged" KeyDown="PlaceBox_KeyDown"/>
                                            <TextBlock x:Name="PlaceHint" Text="Game name, place ID or roblox.com link"
                                                       IsHitTestVisible="False" Foreground="{DynamicResource ThFaint}" FontSize="14"
                                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                        <Button x:Name="PlaceOpenBtn" Grid.Column="1" Content="Search"
                                                Margin="8,0,0,0" Padding="22,10" FontSize="13"
                                                Click="OpenPlaceBtn_Click"/>
                                        <Button x:Name="PlaceRandomBtn" Grid.Column="2" Content="Random"
                                                Margin="6,0,0,0" Padding="18,10" FontSize="13"
                                                Background="#2FBF71" Visibility="Collapsed"
                                                Click="OpenPlaceRandomBtn_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="SearchStatus" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                               Margin="2,10,0,0" Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="SearchScroll" MaxHeight="290" Margin="0,10,0,0"
                                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <ItemsControl x:Name="SearchResults" ItemTemplate="{StaticResource SearchCard}"
                                                      Margin="0,0,6,0"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="SearchHelp"
                                               Text="Type a name to search. Open lets you choose a server, Random joins one straight away. Both need an account selected in the sidebar."
                                               Foreground="{DynamicResource ThFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="GamePanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ThCard}" CornerRadius="14">
                            <Grid>
                                <Border x:Name="BannerBorder" CornerRadius="14"/>
                                <Border CornerRadius="14">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#F0171A22" Offset="0"/>
                                            <GradientStop Color="#55171A22" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Margin="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="GameIcon" Grid.Column="0" Width="104" Height="104"
                                            CornerRadius="18" Background="{DynamicResource ThDim}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="20" ShadowDepth="4"/>
                                        </Border.Effect>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="GameName" Text="Loading game..." FontSize="26"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="GameMeta" Foreground="{DynamicResource ThText2}" FontSize="13"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock x:Name="GamePlaying" Foreground="#3DD68C" FontSize="13"
                                                   FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock Text="Play joins a random server. Pick one below, or press Server hop to try a server you have not been in yet. With an account selected in the sidebar the login never expires."
                                                   Foreground="{DynamicResource ThSoft}" FontSize="12" TextWrapping="Wrap"
                                                   Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="FavBtn" Width="52" Height="52" Padding="0"
                                                Background="{DynamicResource ThDim}" Margin="0,0,10,0" Click="FavBtn_Click">
                                            <TextBlock x:Name="FavIcon" Text="&#xE734;"
                                                       FontFamily="{StaticResource Icons}" FontSize="20"/>
                                        </Button>
                                        <Button x:Name="PlayBtn" Content="Preparing..." Width="170" Height="52"
                                                FontSize="17" Background="#2FBF71" IsEnabled="False"
                                                Click="PlayBtn_Click">
                                            <Button.Effect>
                                                <DropShadowEffect Color="#2FBF71" Opacity="0.3" BlurRadius="22" ShadowDepth="0"/>
                                            </Button.Effect>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                BorderThickness="1" CornerRadius="14" Padding="16,10" Margin="0,14,0,0">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="SORT" Foreground="{DynamicResource ThFaint}" FontSize="10.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,3,10,3"/>
                                <Button x:Name="SortMostBtn" Content="Most players" FontSize="12" Padding="12,7"
                                        Margin="0,3,6,3" Click="SortMost_Click"/>
                                <Button x:Name="SortFewestBtn" Content="Fewest players" FontSize="12" Padding="12,7"
                                        Margin="0,3,6,3" Click="SortFewest_Click"/>
                                <Button x:Name="SortPingBtn" Content="Best ping" FontSize="12" Padding="12,7"
                                        Margin="0,3,18,3" Click="SortPing_Click"/>

                                <TextBlock Text="FILTERS" Foreground="{DynamicResource ThFaint}" FontSize="10.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="0,3,10,3"/>
                                <TextBlock Text="Min players" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,3,6,3"/>
                                <TextBox x:Name="MinPlayersBox" Width="52" FontSize="13" MaxLength="3"
                                         Margin="0,3,12,3" PreviewTextInput="DigitsOnly_PreviewTextInput"
                                         TextChanged="Filter_Changed"/>

                                <TextBlock Text="Max ping" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,3,6,3"/>
                                <TextBox x:Name="MaxPingBox" Width="52" FontSize="13" MaxLength="4"
                                         Margin="0,3,12,3" PreviewTextInput="DigitsOnly_PreviewTextInput"
                                         TextChanged="Filter_Changed"/>

                                <TextBlock Text="Region" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,3,6,3"/>
                                <TextBox x:Name="RegionFilterBox" Width="100" FontSize="13" MaxLength="30"
                                         Margin="0,3,0,3" TextChanged="Filter_Changed"/>
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BackBtn" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                        Margin="0,0,12,0" Click="BackToSearch_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Search"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RefreshBtn" Content="Refresh" FontSize="12" Padding="12,7"
                                        Background="{DynamicResource ThDim}" Margin="0,0,6,0" Click="RefreshBtn_Click"/>
                                <Button x:Name="LoadMoreBtn" Content="Load more" FontSize="12" Padding="12,7"
                                        Background="{DynamicResource ThDim}" Margin="0,0,6,0" Visibility="Collapsed"
                                        Click="LoadMoreBtn_Click"/>
                                <Button x:Name="HopBtn" Content="Server hop" FontSize="12" Padding="12,7"
                                        Margin="0,0,6,0" IsEnabled="False" Click="HopBtn_Click"/>
                                <Button x:Name="RejoinLastBtn" Content="Rejoin last server" FontSize="12"
                                        Padding="12,7" Background="{DynamicResource ThDim}" IsEnabled="False"
                                        Margin="0,0,6,0" Click="RejoinLastBtn_Click"/>
                                <Button x:Name="DetectBtn" Content="Detect regions" FontSize="12"
                                        Padding="12,7" Background="{DynamicResource ThDim}" Click="DetectBtn_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="ServerCount" Grid.Column="1" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="19,0,26,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PLAYERS" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="PING" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="FPS" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="3" Text="REGION" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                            </Grid>

                            <ScrollViewer Grid.Row="1" Style="{StaticResource EdgeScroll}" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ServerList" Margin="0,0,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                                                    CornerRadius="12" Padding="0" Margin="0,0,0,8" BorderThickness="1">
                                                <Grid>
                                                    <Border Width="4" HorizontalAlignment="Left" Background="{Binding PingBrush}"
                                                            CornerRadius="12,0,0,12"/>
                                                    <Grid Margin="18,10,14,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="160"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Icons}" FontSize="13"
                                                                       Foreground="{DynamicResource ThMuted}" VerticalAlignment="Center"
                                                                       Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding PlayersText}" FontSize="14" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding PingText}"
                                                                   FontSize="14" FontWeight="Bold"
                                                                   Foreground="{Binding PingBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding FpsText}"
                                                                   FontSize="14" Foreground="{DynamicResource ThText2}"
                                                                   VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource Icons}" FontSize="12"
                                                                       Foreground="{DynamicResource ThMuted}" VerticalAlignment="Center"
                                                                       Margin="0,0,7,0"/>
                                                            <TextBlock Text="{Binding RegionText}" FontSize="14"
                                                                       Foreground="{DynamicResource ThSoft}"
                                                                       VerticalAlignment="Center" MaxWidth="110"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Grid Grid.Column="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Button Grid.Column="0" Content="Copy link" Tag="{Binding Id}"
                                                                    FontSize="12" Padding="0,7" Margin="0,0,6,0"
                                                                    Background="{DynamicResource ThDim}"
                                                                    ToolTip="Copy a rostr:// link to this server"
                                                                    Click="CopyLinkBtn_Click"/>
                                                            <Button Grid.Column="1" Content="Join" Tag="{Binding Id}"
                                                                    FontSize="12" Padding="0,7" Background="#2FBF71"
                                                                    Click="JoinBtn_Click"/>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- LIBRARY PAGE -->
                <Grid x:Name="LibraryPage" Visibility="Collapsed">
                    <ScrollViewer x:Name="LibScroll" Style="{StaticResource EdgeScroll}" VerticalScrollBarVisibility="Auto"
                                  SizeChanged="LibScroll_SizeChanged">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Library" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Your games and how long you have played them. Play and Rejoin open the Roblox website for a fresh login unless an account is selected."
                                       Foreground="{DynamicResource ThMuted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,14">
                                <StackPanel>
                                    <TextBlock Text="TOTAL PLAYTIME" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatTotal" Text="0 min" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,14">
                                <StackPanel>
                                    <TextBlock Text="GAMES PLAYED" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatGames" Text="0" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="MOST PLAYED" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatTop" Text="-" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Join a private server" Style="{StaticResource RowTitle}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PrivateBox" FontSize="13"/>
                                        <Button x:Name="PrivateJoinBtn" Grid.Column="1" Content="Join private server"
                                                Margin="8,0,0,0" Padding="16,9" FontSize="13" Click="PrivateJoin_Click"/>
                                    </Grid>
                                    <TextBlock Text="Paste a private server link (roblox.com/games/...?privateServerLinkCode=... or a roblox.com/share link). Needs an account selected in the sidebar."
                                               Foreground="{DynamicResource ThFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="2,6,0,12">
                                <Border Width="3" Height="14" CornerRadius="2" Background="#F5C451" Margin="0,0,8,0"/>
                                <TextBlock Text="FAVORITES" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ThDim}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="FavCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="FavEmpty" Text="No favorites yet. Open a game and press the star."
                                       Foreground="{DynamicResource ThFaint}" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,18"/>
                            <ItemsControl x:Name="FavList" ItemTemplate="{StaticResource LibCard}" Margin="-6,0,-6,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding LibColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="2,6,0,12">
                                <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource ThAccent}" Margin="0,0,8,0"/>
                                <TextBlock Text="RECENT" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ThDim}" CornerRadius="9" Padding="7,1" Margin="8,0,0,0">
                                    <TextBlock x:Name="RecentCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="RecentEmpty" Text="Games you launch will show up here."
                                       Foreground="{DynamicResource ThFaint}" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,18"/>
                            <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource LibCard}" Margin="-6,0,-6,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding LibColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- README PAGE -->
                <Grid x:Name="ReadmePage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="README" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="The project README, loaded from GitHub" Foreground="{DynamicResource ThMuted}"
                                   FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Reload" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                Margin="0,0,6,0" Click="ReadmeReload_Click"/>
                        <Button Content="Open on GitHub" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                Margin="0,0,12,0" Click="ReadmeGitHub_Click"/>
                        <TextBlock x:Name="ReadmeMsg" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="ReadmeHost" Grid.Row="2" Background="{DynamicResource ThCard}" CornerRadius="11"
                            ClipToBounds="True"/>
                </Grid>

                <!-- CHANGE LOG PAGE -->
                <Grid x:Name="ChangelogPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock x:Name="ChangelogTitle" Text="Change log" FontSize="28" FontWeight="Bold"/>
                        <TextBlock x:Name="ChangelogSub" Foreground="{DynamicResource ThMuted}"
                                   FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="ChangelogInstallBtn" Content="Install" FontSize="12" Padding="14,7"
                                Margin="0,0,6,0" Visibility="Collapsed" Click="ChangelogInstall_Click"/>
                        <Button Content="Back" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                Margin="0,0,6,0" Click="ChangelogBack_Click"/>
                        <Button Content="Reload" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                Margin="0,0,6,0" Click="ChangelogReload_Click"/>
                        <Button Content="Open on GitHub" FontSize="12" Padding="12,7" Background="{DynamicResource ThDim}"
                                Margin="0,0,12,0" Click="ChangelogGitHub_Click"/>
                        <TextBlock x:Name="ChangelogMsg" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border x:Name="ChangelogHost" Grid.Row="2" Background="{DynamicResource ThCard}" CornerRadius="11"
                            ClipToBounds="True"/>
                </Grid>

                <!-- TRENDING PAGE (player counts from GitHub) -->
                <local:TrendingView x:Name="TrendingPage" Visibility="Collapsed"/>

                <!-- FRIENDS PAGE -->
                <Grid x:Name="FriendsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Friends" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Join a friend who is in a game. Uses the account selected in the sidebar. A friend's privacy settings decide whether you can join."
                                   Foreground="{DynamicResource ThMuted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,12">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="IN GAME" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FrInGame" Text="0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,10,12">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="ONLINE" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FrOnline" Text="0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel>
                                    <TextBlock Text="OFFLINE" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="FrOffline" Text="0" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource ThCard}" BorderBrush="{DynamicResource ThEdge}"
                            BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBox x:Name="FriendsSearchBox" FontSize="13" MaxLength="40"
                                         TextChanged="FriendsSearch_TextChanged"/>
                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False" Margin="12,0,0,0"
                                            VerticalAlignment="Center" x:Name="FriendsSearchHintRow">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="12"
                                               Foreground="{DynamicResource ThFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="FriendsSearchHint" Text="Search friends..." FontSize="13"
                                               Foreground="{DynamicResource ThFaint}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="FriendsCount" Foreground="{DynamicResource ThMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button x:Name="FriendsOfflineBtn" Content="Offline friends: hidden" FontSize="12"
                                        Padding="12,7" Background="{DynamicResource ThDim}" Margin="0,0,6,0" Click="FriendsOffline_Click"/>
                                <Button x:Name="FriendsRefreshBtn" Content="Refresh" FontSize="12" Padding="12,7"
                                        Background="{DynamicResource ThDim}" Click="FriendsRefresh_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="3" Style="{StaticResource EdgeScroll}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="FriendsEmpty" Text="Pick an account in the sidebar to see its friends."
                                       Foreground="{DynamicResource ThFaint}" FontSize="13" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="FriendsList" ItemTemplate="{StaticResource FriendCard}"
                                          Margin="0,0,6,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- MEDIA PAGE -->
                <Grid x:Name="MediaPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Gallery" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Screenshots and recordings of your Roblox games. Click one to view or play it here."
                                   Foreground="{DynamicResource ThMuted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MediaShotBtn" Padding="16,9" FontSize="13" Margin="0,0,8,0"
                                        Click="MediaShot_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE722;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Screenshot"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MediaRecBtn" Padding="16,9" FontSize="13" Click="MediaRec_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MediaRecGlyph" Text="&#xE714;" FontFamily="{StaticResource Icons}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="MediaRecText" Text="Record"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MediaReplayBtn" Padding="16,9" FontSize="13" Margin="8,0,0,0"
                                        Visibility="Collapsed" Click="MediaReplay_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Save replay"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="ReplayStatusPanel" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <Ellipse x:Name="ReplayStatusDot" Width="8" Height="8" Fill="{DynamicResource ThMuted}"
                                         VerticalAlignment="Center" Margin="2,0,8,0"/>
                                <TextBlock x:Name="ReplayStatusText" Text="Replay buffer is off"
                                           Foreground="{DynamicResource ThMuted}" FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="MediaHotkeyHint"
                                       Text="Hotkeys: Ctrl + Shift + F10 takes a screenshot, Ctrl + Shift + F11 starts and stops a recording. They work while you are in the game. Change them in Settings > Gallery."
                                       Foreground="{DynamicResource ThFaint}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="MediaScroll" Grid.Row="2" Style="{StaticResource EdgeScroll}"
                                  VerticalScrollBarVisibility="Auto" SizeChanged="MediaScroll_SizeChanged">
                        <StackPanel Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="MediaAllBtn" Style="{StaticResource TabBtn}" Content="All" Tag="all"
                                        Margin="0,0,4,0" Click="MediaFilter_Click"/>
                                <Button x:Name="MediaFavsBtn" Style="{StaticResource TabBtn}" Content="Favorites" Tag="favs"
                                        Margin="0,0,4,0" Click="MediaFilter_Click"/>
                                <Button x:Name="MediaShotsBtn" Style="{StaticResource TabBtn}" Content="Screenshots" Tag="shots"
                                        Margin="0,0,4,0" Click="MediaFilter_Click"/>
                                <Button x:Name="MediaVideosBtn" Style="{StaticResource TabBtn}" Content="Videos" Tag="videos"
                                        Margin="0,0,10,0" Click="MediaFilter_Click"/>
                                <Border Background="{DynamicResource ThDim}" CornerRadius="9" Padding="7,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaCount" Text="0" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThText2}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="MediaEmpty"
                                       Text="Nothing here yet. Press Screenshot or Record, or use the hotkeys while you play."
                                       Foreground="{DynamicResource ThFaint}" FontSize="13" TextWrapping="Wrap"
                                       Margin="2,0,0,18"/>
                            <ItemsControl x:Name="MediaList" ItemTemplate="{StaticResource MediaCard}" Margin="-6,0,-6,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding MediaColumns, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Viewer: a picture, or a video with its own controls. Covers the page while open. -->
                    <Grid x:Name="MediaViewer" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="20"
                          Margin="-28,0,-28,-24" Background="{DynamicResource ThBg}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="28,6,28,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ViewTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBox x:Name="ViewTitleBox" Visibility="Collapsed" FontSize="14" Padding="8,5"
                                     VerticalAlignment="Center" Margin="0,0,12,0" MaxLength="100"
                                     KeyDown="ViewTitleBox_KeyDown" LostKeyboardFocus="ViewTitleBox_LostFocus"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ViewFavBtn" FontSize="12" Padding="14,8" Margin="0,0,8,0"
                                        Background="{DynamicResource ThDim}" Click="ViewFav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ViewFavGlyph" Text="&#xE734;" FontFamily="{StaticResource Icons}"
                                                   Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Favorite"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="Rename" FontSize="12" Padding="14,8" Margin="0,0,8,0"
                                        Background="{DynamicResource ThDim}" Click="ViewRename_Click"/>
                                <Button Content="Copy" FontSize="12" Padding="14,8" Margin="0,0,8,0"
                                        Background="{DynamicResource ThDim}" Click="ViewCopy_Click"/>
                                <Button Content="Show in folder" FontSize="12" Padding="14,8" Margin="0,0,8,0"
                                        Background="{DynamicResource ThDim}" Click="ViewFolder_Click"/>
                                <Button Content="Delete" FontSize="12" Padding="14,8" Margin="0,0,8,0"
                                        Background="#F25C5C" Click="ViewDelete_Click"/>
                                <Button Content="Close" FontSize="12" Padding="14,8"
                                        Background="{DynamicResource ThDim}" Click="ViewClose_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="28,0,28,0">
                            <Image x:Name="ImageView" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <MediaElement x:Name="VideoView" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                          ScrubbingEnabled="True" Stretch="Uniform" Visibility="Collapsed"
                                          MediaOpened="VideoView_MediaOpened" MediaEnded="VideoView_MediaEnded"
                                          MediaFailed="VideoView_MediaFailed" MouseLeftButtonUp="VideoView_Click"/>
                        </Grid>

                        <Border x:Name="VideoBar" Grid.Row="2" Style="{StaticResource Card}" Padding="14,8"
                                Margin="28,12,28,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Padding="12,8" Click="ViewPlay_Click">
                                    <TextBlock x:Name="PlayGlyph" Text="&#xE769;" FontFamily="{StaticResource Icons}"/>
                                </Button>
                                <TextBlock x:Name="TimeText" Grid.Column="1" Text="0:00" Margin="14,0,10,0"
                                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThText2}"/>
                                <Slider x:Name="SeekSlider" Grid.Column="2" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                        ValueChanged="SeekSlider_ValueChanged"/>
                                <TextBlock x:Name="DurText" Grid.Column="3" Text="0:00" Margin="10,0,16,0"
                                           VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource ThText2}"/>
                                <TextBlock Grid.Column="4" Text="&#xE767;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ThMuted}"/>
                                <Slider x:Name="VolSlider" Grid.Column="5" Minimum="0" Maximum="1" Value="0.8"
                                        VerticalAlignment="Center" ValueChanged="VolSlider_ValueChanged"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- SETTINGS PAGE -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                        <TextBlock Text="Settings" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Applied automatically every time you launch a game" Foreground="{DynamicResource ThMuted}"
                                   FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Left tab list -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource ThBg2}" CornerRadius="11" Padding="6"
                            VerticalAlignment="Top" Margin="0,0,18,0">
                        <StackPanel>
                            <Button x:Name="TabAboutBtn" Style="{StaticResource TabBtn}" Content="About"
                                    Tag="3" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabPerfBtn" Style="{StaticResource TabBtn}" Content="Performance"
                                    Tag="0" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabOverlayBtn" Style="{StaticResource TabBtn}" Content="Overlays"
                                    Tag="1" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabGalleryBtn" Style="{StaticResource TabBtn}" Content="Gallery"
                                    Tag="7" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabGeneralBtn" Style="{StaticResource TabBtn}" Content="General"
                                    Tag="2" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabAppearanceBtn" Style="{StaticResource TabBtn}" Content="Appearance"
                                    Tag="4" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabDiscordBtn" Style="{StaticResource TabBtn}" Content="Discord"
                                    Tag="5" Click="SettingsTab_Click" Margin="0,0,0,2"/>
                            <Button x:Name="TabStorageBtn" Style="{StaticResource TabBtn}" Content="Storage"
                                    Tag="6" Click="SettingsTab_Click"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource EdgeScroll}" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1100" HorizontalAlignment="Stretch" Margin="0,0,12,0">

                            <!-- PERFORMANCE -->
                            <StackPanel x:Name="SetPerfPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="FPS cap" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="The highest frame rate Roblox will draw. Slider: 30 to 360. You can type up to 1000 in the box."
                                                   Style="{StaticResource RowDesc}"/>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="FpsSlider" Grid.Column="0" Minimum="30" Maximum="360"
                                                    Value="144" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                                    ValueChanged="FpsSlider_ValueChanged"/>
                                            <TextBox x:Name="FpsBox" Grid.Column="1" Width="90" Margin="16,0,0,0"
                                                     MaxLength="4" PreviewTextInput="DigitsOnly_PreviewTextInput"
                                                     TextChanged="FpsBox_TextChanged" LostFocus="FpsBox_LostFocus"/>
                                        </Grid>
                                        <Button Content="Save FPS cap" Click="SaveBtn_Click" HorizontalAlignment="Left"
                                                Padding="20,9" FontSize="13" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="FastFlag presets" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="One click turns a group of flags on or off. They are written into the client before every launch. Roblox ignores flags it no longer allows, so a preset can stop having an effect after a Roblox update."
                                                   Style="{StaticResource RowDesc}"/>
                                        <ItemsControl x:Name="PresetList" ItemTemplate="{StaticResource PresetCard}"
                                                      Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock x:Name="PresetMsg" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Roblox allowlist (official)" FontSize="12" Padding="14,8"
                                                    Background="{DynamicResource ThDim}" Margin="0,0,6,6"
                                                    Click="AllowlistOfficial_Click"/>
                                            <Button Content="Community allowlist (GitHub)" FontSize="12" Padding="14,8"
                                                    Background="{DynamicResource ThDim}" Margin="0,0,6,6"
                                                    Click="AllowlistCommunity_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="FastFlag editor" Style="{StaticResource CardHeading}"/>
                                                <TextBlock Text="Advanced. Edit the raw JSON that the presets write to. A wrong value can break the game."
                                                           Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Button x:Name="FlagsEditorBtn" Grid.Column="1" Content="Show editor"
                                                    FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                    VerticalAlignment="Center" Click="FlagsEditorBtn_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="FlagsEditor" Visibility="Collapsed" Margin="0,14,0,0">
                                            <TextBlock Text="Names start with FFlag, DFFlag, SFFlag, FInt, DFInt, FString, DFString, FLog or DFLog. Leave the box empty or as an empty object to use none."
                                                       Foreground="{DynamicResource ThSoft}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBox x:Name="FlagsBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                     Height="180" FontFamily="Consolas" FontSize="12"
                                                     TextAlignment="Left" VerticalContentAlignment="Top"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Content="Save flags" FontSize="12" Padding="16,8" Margin="0,0,6,0"
                                                        Click="FlagsSave_Click"/>
                                                <Button Content="Reload" FontSize="12" Padding="16,8" Background="{DynamicResource ThDim}"
                                                        Margin="0,0,6,0" Click="FlagsReload_Click"/>
                                                <Button Content="Clear all" FontSize="12" Padding="16,8" Background="{DynamicResource ThDim}"
                                                        Margin="0,0,12,0" Click="FlagsClear_Click"/>
                                                <TextBlock x:Name="FlagsMsg" FontSize="12" VerticalAlignment="Center"
                                                           TextWrapping="Wrap" MaxWidth="320"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- OVERLAY -->
                            <StackPanel x:Name="SetOverlayPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Stats overlay" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Ping, CPU, RAM, session time and region. It sits inside the Roblox window and only shows while that window is in front." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="OverlayToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="OverlayToggle_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Show it in game" Style="{StaticResource RowTitle}"/>
                                            <TextBlock x:Name="OverlayShowDesc" Text="Hotkey: Ctrl + Shift + O. Turns the stats overlay on screen off without closing it." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="OverlayShowToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="OverlayShowToggle_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hotkey" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Click the key box, then press the keys you want. Use Ctrl, Alt or Shift with a key. Esc cancels."
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="HotkeyBtn" Content="Ctrl + Shift + O" MinWidth="130"
                                                    FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                    Click="HotkeyBtn_Click" LostKeyboardFocus="HotkeyBtn_LostFocus"/>
                                            <Button Content="Reset" FontSize="12" Padding="12,8" Margin="6,0,0,0"
                                                    Background="{DynamicResource ThDim}" Click="HotkeyReset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Position" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Pick the corner of the Roblox window where the overlay appears."
                                                           Style="{StaticResource RowDesc}"/>
                                                <Button Content="Preview" FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                                        Click="OverlayPreview_Click"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="160" Height="100" Background="{DynamicResource ThBg}"
                                                    BorderBrush="{DynamicResource ThTrack}" BorderThickness="1.5" CornerRadius="8">
                                                <Grid Margin="7">
                                                    <TextBlock Text="Roblox window" Foreground="{DynamicResource ThDisabled}" FontSize="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Button x:Name="CornerTL" Tag="0" Width="38" Height="22" Padding="0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                                            ToolTip="Top left" Click="Corner_Click"/>
                                                    <Button x:Name="CornerTR" Tag="1" Width="38" Height="22" Padding="0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            ToolTip="Top right" Click="Corner_Click"/>
                                                    <Button x:Name="CornerBL" Tag="2" Width="38" Height="22" Padding="0"
                                                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            ToolTip="Bottom left" Click="Corner_Click"/>
                                                    <Button x:Name="CornerBR" Tag="3" Width="38" Height="22" Padding="0"
                                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                            ToolTip="Bottom right" Click="Corner_Click"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                    <TextBlock Text="What the stats overlay shows" Style="{StaticResource CardHeading}"/>
                                    <TextBlock Text="Turn single lines on or off." Style="{StaticResource RowDesc}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Ping" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Latency to the game server." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldPingToggle" Grid.Column="1" Tag="ping" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="CPU" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="How much processor the Roblox client uses." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldCpuToggle" Grid.Column="1" Tag="cpu" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="RAM" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Memory used by the Roblox client." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldRamToggle" Grid.Column="1" Tag="ram" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Session time" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="How long this game has been running." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldTimeToggle" Grid.Column="1" Tag="time" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Region" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Where the server is located." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldRegionToggle" Grid.Column="1" Tag="region" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Account name" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Only shown when you have more than one account added." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="FieldUserToggle" Grid.Column="1" Tag="user" Style="{StaticResource Switch}"
                                                      Click="OverlayField_Click"/>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="For the in-game FPS counter press Shift + F5. Ping marked with ~ is an estimate: Roblox servers do not answer ping, so the last router on the way is measured instead."
                                           Foreground="{DynamicResource ThFaint}" FontSize="12" TextWrapping="Wrap" Margin="4,0,0,14"/>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Dim menu" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Press the key while Roblox is in front to darken and blur the game screen and open a menu on top of it: your local time, how long you have been playing, the friends who are playing (with a Join button) and the wiki of the game. The game keeps running underneath." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DimToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="DimToggle_Click"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Dim menu key" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Click the key box, then press the keys you want. Use Ctrl, Alt or Shift with a key, left and right keys are kept apart. Esc cancels. It only works while Roblox is in front, so other apps keep their shortcuts."
                                                       Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="DimKeyBtn" Content="Left Ctrl + Tab" MinWidth="130"
                                                    FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                    Click="DimKeyBtn_Click" LostKeyboardFocus="DimKeyBtn_LostFocus"/>
                                            <Button Content="Reset" FontSize="12" Padding="12,8" Margin="6,0,0,0"
                                                    Background="{DynamicResource ThDim}" Click="DimKeyReset_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GENERAL -->
                            <StackPanel x:Name="SetGeneralPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Launcher behavior" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Minimize when the game starts" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="The launcher gets out of the way once Roblox is launching." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="MinimizeToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="MinimizeToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Keep running in the tray when closed" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="The X button hides Rostr next to the clock instead of closing it, so your Discord status and playtime keep working. Right-click the tray icon and choose Exit to quit." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="TrayToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="TrayToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Rostr starts hidden in the tray when you turn on your PC, so you never have to open it by hand. Pressing Install in Settings > About turns this on." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="StartupToggle_Click"/>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Playing" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Skip choosing a server" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Pressing Play on roblox.com launches Roblox straight away without opening Rostr, and Roblox picks the server, like it does without a launcher. Play inside Rostr joins a random server with the best ping." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="AutoBestToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="AutoBestToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Multi Roblox" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Run several clients at once. Keep this launcher open while they run. Roblox can change how it checks for a second client at any time." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="MultiToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="MultiToggle_Click"/>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- APPEARANCE -->
                            <StackPanel x:Name="SetAppearancePanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Appearance" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="Language" Style="{StaticResource RowTitle}" Margin="0,14,0,6"/>
                                        <WrapPanel x:Name="LangPanel"/>
                                        <TextBlock Text="Theme" Style="{StaticResource RowTitle}" Margin="0,14,0,6"/>
                                        <WrapPanel x:Name="ThemePanel"/>
                                    </StackPanel>
                                </Border>

                            </StackPanel>

                            <!-- DISCORD -->
                            <StackPanel x:Name="SetDiscordPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Discord status" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Discord status" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Shows the game you are playing on your Discord profile, or that you are browsing in Rostr when no game is running." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DiscordToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="DiscordToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Hide the game name on Discord" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Your status says &quot;Playing a Roblox game&quot; and the game page button is left out." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DiscordHideToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="DiscordHideToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Show browsing servers on Discord" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="When you open a game page, your status says &quot;Browsing servers&quot; with the game name. Turn off to only show that you are in the launcher." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="DiscordBrowseToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="DiscordBrowseToggle_Click"/>
                                    </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- GALLERY -->
                            <StackPanel x:Name="SetGalleryPanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Keybinds" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="Click the key box, then press the keys you want. Use Ctrl, Alt or Shift with a key. Esc cancels."
                                                   Style="{StaticResource RowDesc}" Margin="0,6,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Take screenshot" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="ShotKeyBtn" Tag="shot" Content="Ctrl + Shift + F10" MinWidth="130"
                                                        FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                        Click="MediaKeyBtn_Click" LostKeyboardFocus="MediaKeyBtn_LostFocus"/>
                                                <Button Tag="shot" Content="Reset" FontSize="12" Padding="12,8" Margin="6,0,0,0"
                                                        Background="{DynamicResource ThDim}" Click="MediaKeyReset_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Start / stop recording" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
