                                                <Button x:Name="RecKeyBtn" Tag="rec" Content="Ctrl + Shift + F11" MinWidth="130"
                                                        FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                        Click="MediaKeyBtn_Click" LostKeyboardFocus="MediaKeyBtn_LostFocus"/>
                                                <Button Tag="rec" Content="Reset" FontSize="12" Padding="12,8" Margin="6,0,0,0"
                                                        Background="{DynamicResource ThDim}" Click="MediaKeyReset_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Save instant replay" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="ReplayKeyBtn" Tag="replay" Content="Ctrl + Shift + F9" MinWidth="130"
                                                        FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                                                        Click="MediaKeyBtn_Click" LostKeyboardFocus="MediaKeyBtn_LostFocus"/>
                                                <Button Tag="replay" Content="Reset" FontSize="12" Padding="12,8" Margin="6,0,0,0"
                                                        Background="{DynamicResource ThDim}" Click="MediaKeyReset_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Recording" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="Higher quality looks sharper but makes bigger files and uses more CPU. 60 FPS is smoother and also heavier."
                                                   Style="{StaticResource RowDesc}" Margin="0,6,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Frame rate" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="RecFps30Btn" Tag="30" Content="30 FPS" MinWidth="76" FontSize="12"
                                                        Padding="14,8" Margin="0,0,6,0" Click="RecFps_Click"/>
                                                <Button x:Name="RecFps60Btn" Tag="60" Content="60 FPS" MinWidth="76" FontSize="12"
                                                        Padding="14,8" Click="RecFps_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Quality" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="RecQLowBtn" Tag="0" Content="Low" MinWidth="76" FontSize="12"
                                                        Padding="14,8" Margin="0,0,6,0" Click="RecQuality_Click"/>
                                                <Button x:Name="RecQMedBtn" Tag="1" Content="Medium" MinWidth="76" FontSize="12"
                                                        Padding="14,8" Margin="0,0,6,0" Click="RecQuality_Click"/>
                                                <Button x:Name="RecQHighBtn" Tag="2" Content="High" MinWidth="76" FontSize="12"
                                                        Padding="14,8" Click="RecQuality_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Record game sound" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="Captures audio from Roblox Player only. Audio from other apps is not included."
                                                           Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="RecAudioToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                          Click="RecAudioToggle_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Instant replay" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="ReplayLengthTitle" Text="Keep the last 30 seconds" Style="{StaticResource RowTitle}"/>
                                                <TextBlock x:Name="ReplayDescription" Text="While Roblox is open, Rostr records in the background. Press the hotkey to save the last 30 seconds as a clip. This uses some CPU and a little disk space, and it pauses while you record a video yourself."
                                                           Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="ReplayToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                          Click="ReplayToggle_Click"/>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Replay length" Style="{StaticResource RowTitle}"
                                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="Replay15Btn" Tag="15" Content="15 s" MinWidth="52" FontSize="12"
                                                        Padding="10,8" Margin="0,0,6,0" Click="ReplayLength_Click"/>
                                                <Button x:Name="Replay30Btn" Tag="30" Content="30 s" MinWidth="52" FontSize="12"
                                                        Padding="10,8" Margin="0,0,6,0" Click="ReplayLength_Click"/>
                                                <Button x:Name="Replay60Btn" Tag="60" Content="60 s" MinWidth="52" FontSize="12"
                                                        Padding="10,8" Margin="0,0,6,0" Click="ReplayLength_Click"/>
                                                <Button x:Name="Replay120Btn" Tag="120" Content="120 s" MinWidth="58" FontSize="12"
                                                        Padding="10,8" Click="ReplayLength_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Location" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Saved in" Style="{StaticResource RowTitle}"/>
                                                <TextBlock x:Name="MediaFolderText" Style="{StaticResource RowDesc}"
                                                           Margin="0,2,12,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Change folder" FontSize="12" Padding="14,8"
                                                    Margin="0,0,8,0" Background="{DynamicResource ThDim}"
                                                    Click="MediaFolderChange_Click"/>
                                            <Button Grid.Column="2" Content="Open folder" FontSize="12" Padding="14,8"
                                                    Background="{DynamicResource ThDim}" Click="MediaFolderOpen_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- STORAGE -->
                            <StackPanel x:Name="SetStoragePanel" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Disk space" Style="{StaticResource CardHeading}" Margin="0,0,0,14"/>
                                        <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="Delete old client versions" Style="{StaticResource RowTitle}"/>
                                            <TextBlock Text="Removes client versions you no longer use after an update, to save disk space." Style="{StaticResource RowDesc}"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="CleanupToggle" Grid.Column="1" Style="{StaticResource Switch}"
                                                      Click="CleanupToggle_Click"/>
                                    </Grid>
                                        <Border Height="1" Background="{DynamicResource ThLine}" Margin="0,14"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="Disk usage" Style="{StaticResource RowTitle}"/>
                                                <TextBlock x:Name="DiskText" Text="Checking disk usage..."
                                                           Style="{StaticResource RowDesc}"/>
                                            </StackPanel>
                                            <Button x:Name="CleanNowBtn" Grid.Column="1" Content="Clean now" FontSize="12"
                                                    Padding="14,8" Background="{DynamicResource ThDim}" VerticalAlignment="Center"
                                                    Click="CleanNowBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ABOUT -->
                            <StackPanel x:Name="SetAboutPanel">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Updates" Style="{StaticResource CardHeading}"/>
                                        <TextBlock x:Name="VersionText" FontSize="13" Foreground="{DynamicResource ThText2}" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                            <Button x:Name="CheckUpdateBtn" Content="Check for updates" FontSize="12"
                                                    Padding="16,8" Margin="0,0,6,0" Click="CheckUpdate_Click"/>
                                            <Button x:Name="SeeChangelogBtn" Content="See change log" FontSize="12"
                                                    Padding="16,8" Background="{DynamicResource ThDim}"
                                                    Click="SeeChangelog_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Launcher" Style="{StaticResource CardHeading}"/>
                                        <TextBlock Text="Rostr registers itself automatically, so Play on roblox.com opens this launcher. Unregister restores the official one and turns this off until you press Register."
                                                   Style="{StaticResource RowDesc}" Margin="0,6,0,8"/>
                                        <TextBlock x:Name="RegisterState" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="Register" Margin="0,0,6,0" Click="RegisterBtn_Click"/>
                                            <Button Content="Unregister" Background="{DynamicResource ThDim}" Margin="6,0,0,0"
                                                    Click="UnregisterBtn_Click"/>
                                        </UniformGrid>
                                        <TextBlock Text="Install saves a copy of Rostr in your Rostr data folder, adds it to the Start menu so searching for it in Windows finds it, and puts a shortcut on your desktop. Everything points at that copy, so you can delete the downloaded Rostr.exe afterwards."
                                                   Style="{StaticResource RowDesc}" Margin="0,20,0,8"/>
                                        <TextBlock x:Name="InstallState" FontSize="13" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <UniformGrid Columns="2">
                                            <Button x:Name="InstallBtn" Content="Install (Start menu + desktop)" Margin="0,0,6,0" Click="InstallBtn_Click"/>
                                            <Button Content="Remove shortcuts" Background="{DynamicResource ThDim}" Margin="6,0,0,0"
                                                    Click="RemoveShortcutsBtn_Click"/>
                                        </UniformGrid>
                                        <Button Content="Open log file" FontSize="12" Padding="16,8" Background="{DynamicResource ThDim}"
                                                Margin="0,12,0,0" HorizontalAlignment="Left" Click="OpenLogBtn_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Window buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionBtn}" Click="MinBtn_Click">
                <TextBlock Text="&#xE921;" FontFamily="{StaticResource Icons}" FontSize="10"/>
            </Button>
            <Button Style="{StaticResource CaptionBtn}" Click="MaxBtn_Click">
                <TextBlock x:Name="MaxIcon" Text="&#xE922;" FontFamily="{StaticResource Icons}" FontSize="10"/>
            </Button>
            <Button Style="{StaticResource CloseCaptionBtn}" Click="CloseBtn_Click">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10"/>
            </Button>
        </StackPanel>
    </Grid>
    </Border>
</Window>