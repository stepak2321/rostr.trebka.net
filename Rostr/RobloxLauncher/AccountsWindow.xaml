<Window x:Class="RobloxLauncher.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounts" Width="540" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThText}"
        FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26">
            <TextBlock Text="Accounts" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Pick who joins from the button at the bottom of the sidebar. Every launch uses the selected account, with no browser needed."
                       Foreground="{DynamicResource ThMuted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <StackPanel x:Name="ListPanel" Margin="0,20,0,0"/>
            <TextBlock x:Name="EmptyText" Text="No accounts yet." Foreground="{DynamicResource ThFaint}" FontSize="13"
                       Margin="0,0,0,0"/>

            <Button Content="Add account (log in)" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Click="AddBtn_Click"/>

            <Border Background="{DynamicResource ThCard}" CornerRadius="12" Padding="16" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="OR PASTE A COOKIE" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="CookieBox" Margin="0,10,0,0" Padding="8" FontSize="13"
                                 Background="{DynamicResource ThBg}" Foreground="White" BorderBrush="{DynamicResource ThTrack}"/>
                    <Button Content="Add from cookie" FontSize="12" Padding="14,8" Background="{DynamicResource ThDim}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="CookieAdd_Click"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="Msg" FontSize="13" TextWrapping="Wrap" Margin="0,16,0,0"/>

            <TextBlock Foreground="{DynamicResource ThFaint}" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="Security: a Roblox cookie gives full access to the account. Cookies are stored encrypted with your Windows login (DPAPI) in accounts.json and are only ever sent to roblox.com. Never share that file or your cookie, and do not paste a cookie someone else gave you."/>
        </StackPanel>
    </ScrollViewer>
</Window>
