<Window x:Class="RobloxLauncher.DimDockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="64" Height="120"
        FontFamily="Segoe UI" Title="Rostr dim dock">
    <Window.Resources>
        <!-- One round-cornered button of the dock. More buttons can be added to the stack later. -->
        <Style x:Key="DockBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dock on the left side of the Roblox window, in the middle of the height. -->
    <Border x:Name="Dock" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="#8C0F1117" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="20" Padding="8,6">
        <StackPanel x:Name="DockStack" Orientation="Vertical">
            <Button x:Name="FriendsBtn" Style="{StaticResource DockBtn}" Click="Friends_Click" ToolTip="Friends playing">
                <Grid>
                    <Border x:Name="FriendsActive" Width="44" Height="44" CornerRadius="14" Background="#2E3D6BFF"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="FriendsGlyph" Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button x:Name="WikiBtn" Style="{StaticResource DockBtn}" Click="Wiki_Click" ToolTip="Game wiki (Fandom)">
                <Grid>
                    <Border x:Name="WikiActive" Width="44" Height="44" CornerRadius="14" Background="#2E3D6BFF"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="WikiGlyph" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>
            <Button x:Name="NotesBtn" Style="{StaticResource DockBtn}" Click="Notes_Click" ToolTip="Notes for this game">
                <Grid>
                    <Border x:Name="NotesActive" Width="44" Height="44" CornerRadius="14" Background="#2E3D6BFF"
                            Visibility="Collapsed"/>
                    <TextBlock x:Name="NotesGlyph" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <!-- Quick actions for the game you are in -->
            <Border Height="1" Margin="6,5" Background="#33FFFFFF"/>
            <Button x:Name="HopBtn" Style="{StaticResource DockBtn}" Click="Hop_Click" ToolTip="Server hop (a new server you have not been in)">
                <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="RejoinBtn" Style="{StaticResource DockBtn}" Click="Rejoin_Click" ToolTip="Rejoin this server">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="LinkBtn" Style="{StaticResource DockBtn}" Click="Link_Click" ToolTip="Copy join link">
                <TextBlock x:Name="LinkGlyph" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
