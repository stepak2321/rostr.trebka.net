<Window x:Class="RobloxLauncher.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        FontFamily="Segoe UI" Title="Overlay">
    <Border Background="#D90F1117" BorderBrush="#2A3040" BorderThickness="1"
            CornerRadius="10" Padding="14,10" MinWidth="190">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PingLabel" Grid.Row="0" Text="PING" Foreground="#7C8499" FontSize="11" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PingText" Text="-" Foreground="#3DD68C"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"/>

            <TextBlock x:Name="CpuLabel" Grid.Row="1" Text="CPU" Foreground="#7C8499" FontSize="11" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuText" Text="-" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"/>

            <TextBlock x:Name="RamLabel" Grid.Row="2" Text="RAM" Foreground="#7C8499" FontSize="11" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RamText" Text="-" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"/>

            <TextBlock x:Name="TimeLabel" Grid.Row="3" Text="TIME" Foreground="#7C8499" FontSize="11" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TimeText" Text="00:00:00" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"/>

            <TextBlock x:Name="RegionLabel" Grid.Row="4" Text="REGION" Foreground="#7C8499" FontSize="11" Margin="0,2,16,2"/>
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RegionText" Text="-" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"/>

            <TextBlock Grid.Row="5" x:Name="AccountLabel" Text="USER" Foreground="#7C8499" FontSize="11"
                       Margin="0,2,16,2" Visibility="Collapsed"/>
            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AccountText" Text="" Foreground="White"
                       FontSize="13" FontWeight="SemiBold" TextAlignment="Right" Margin="0,1,0,1"
                       Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
