<Window x:Class="RobloxLauncher.DimControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" Width="420" Height="60"
        FontFamily="Segoe UI" Title="Rostr dim controls">
    <Window.Resources>
        <!-- Small round icon button with a hover tint. -->
        <Style x:Key="DimIconBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#26FFFFFF" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Right top corner of the dim: the key hint and the close button. -->
    <Border x:Name="Pill" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="#66000000" CornerRadius="22" Padding="16,6,6,6">
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="HintText" Text="Press Left Ctrl + Tab to close" FontSize="13"
                       Foreground="#E6E9F2" VerticalAlignment="Center"/>
            <Button x:Name="CloseBtn" Style="{StaticResource DimIconBtn}" Click="Close_Click" ToolTip="Close">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
