<Window x:Class="RobloxLauncher.DimNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" Background="#141720"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Width="360" Height="340"
        FontFamily="Segoe UI" Title="Rostr notes">
    <Window.Resources>
        <!-- Thin rounded scroll bar that matches the window (instead of the default Windows one). -->
        <Style x:Key="ScrollTrackBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" Background="#4DFFFFFF" CornerRadius="3" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Th" Property="Background" Value="#80FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Th" Property="Background" Value="#B33D6BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#14FFFFFF" CornerRadius="4" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackBtn}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotesHdrBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The text box of the note: no frame, it fills the window. -->
        <Style x:Key="NoteBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6E9F2"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#3D6BFF"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="Transparent" Padding="12,10,6,10">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: drag it to move the window. -->
            <Border x:Name="Header" Grid.Row="0" Background="#1B1F2A" Cursor="SizeAll" Padding="14,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#C8CEDC" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Notes" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Margin="10,0"/>
                    <Button Grid.Column="2" Style="{StaticResource NotesHdrBtn}" Click="Close_Click" ToolTip="Close">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#101218">
                <TextBox x:Name="Box" Style="{StaticResource NoteBox}" AcceptsReturn="True" AcceptsTab="False"
                         TextWrapping="Wrap" MaxLength="8000" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled" TextChanged="Box_TextChanged"/>
                <TextBlock x:Name="Placeholder" Text="Write a note for this game..." FontSize="13.5" Foreground="#6E7488"
                           Margin="13,10,12,0" IsHitTestVisible="False" TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="2" Background="#1B1F2A" Padding="14,5">
                <TextBlock x:Name="StatusText" Text="Saved on this PC" FontSize="11" Foreground="#8A90A3"/>
            </Border>
        </Grid>
    </Border>
</Window>
