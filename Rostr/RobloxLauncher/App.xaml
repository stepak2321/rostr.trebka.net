<Application x:Class="RobloxLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RobloxLauncher"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ThBg" Color="#0F1117"/>
        <SolidColorBrush x:Key="ThBg2" Color="#12141B"/>
        <SolidColorBrush x:Key="ThCard" Color="#171A22"/>
        <SolidColorBrush x:Key="ThEdge" Color="#1F2432"/>
        <SolidColorBrush x:Key="ThLine" Color="#232838"/>
        <SolidColorBrush x:Key="ThDim" Color="#262B38"/>
        <SolidColorBrush x:Key="ThTrack" Color="#2A3040"/>
        <SolidColorBrush x:Key="ThDisabled" Color="#3A4155"/>
        <SolidColorBrush x:Key="ThFaint" Color="#5C6377"/>
        <SolidColorBrush x:Key="ThMuted" Color="#7C8499"/>
        <SolidColorBrush x:Key="ThSoft" Color="#9AA1B5"/>
        <SolidColorBrush x:Key="ThText2" Color="#C9CEDC"/>
        <SolidColorBrush x:Key="ThText" Color="#E6E8EE"/>
        <SolidColorBrush x:Key="ThAccent" Color="#3D6BFF"/>
        <SolidColorBrush x:Key="ThAccentBg" Color="#1B2547"/>
    </Application.Resources>
</Application>
