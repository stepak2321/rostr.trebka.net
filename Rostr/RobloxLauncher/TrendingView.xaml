<UserControl x:Class="RobloxLauncher.TrendingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource ThText}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Trending" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Player counts of the games on the Rostr list, collected every hour. Click a game to see its graph."
                           Foreground="{DynamicResource ThMuted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="16,0,0,0">
                <TextBlock x:Name="UpdatedText" Foreground="{DynamicResource ThMuted}" FontSize="11.5"
                           HorizontalAlignment="Right"/>
                <Button x:Name="RefreshBtn" Content="Refresh" Padding="14,6" Margin="0,6,0,0" Click="Refresh_Click"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Game list -->
            <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="6" Margin="0,0,14,0">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ListPanel"/>
                    </ScrollViewer>
                    <TextBlock x:Name="ListMessage" Foreground="{DynamicResource ThMuted}" FontSize="12.5"
                               TextWrapping="Wrap" Margin="14" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Graph -->
            <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="20,16">
                <Grid>
                    <TextBlock x:Name="PickText" Text="Pick a game on the left to see its player count graph."
                               Foreground="{DynamicResource ThMuted}" FontSize="13" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid x:Name="DetailGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailName" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="Range24Btn" Style="{DynamicResource TabBtn}" Content="24 hours" Tag="24" Margin="0,0,4,0" Click="Range_Click"/>
                                <Button x:Name="Range7Btn" Style="{DynamicResource TabBtn}" Content="7 days" Tag="168" Margin="0,0,4,0" Click="Range_Click"/>
                                <Button x:Name="Range30Btn" Style="{DynamicResource TabBtn}" Content="30 days" Tag="720" Click="Range_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
                            <StackPanel Margin="0,0,34,0">
                                <TextBlock Text="NOW" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatNow" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,34,0">
                                <TextBlock Text="PEAK" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatPeak" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="LOWEST" Foreground="{DynamicResource ThMuted}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="StatLow" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="2" MinHeight="200">
                            <Canvas x:Name="Chart" Background="Transparent" ClipToBounds="True"
                                    SizeChanged="Chart_SizeChanged" MouseMove="Chart_MouseMove" MouseLeave="Chart_MouseLeave"/>
                            <TextBlock x:Name="ChartMessage" Foreground="{DynamicResource ThMuted}" FontSize="13"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
