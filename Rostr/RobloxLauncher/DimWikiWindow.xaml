<Window x:Class="RobloxLauncher.DimWikiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None" ResizeMode="NoResize" Background="#141720"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Width="900" Height="600"
        FontFamily="Segoe UI" Title="Rostr wiki">
    <Window.Resources>
        <Style x:Key="WikiHdrBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Read-only address box: the text can be selected and copied. -->
        <Style x:Key="UrlBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="#C9CEDC"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#3D6BFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#1AFFFFFF" CornerRadius="9" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: drag it to move the window. -->
            <Border x:Name="Header" Grid.Row="0" Background="#1B1F2A" Cursor="SizeAll" Padding="14,6,8,6"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove"
                    MouseLeftButtonUp="Header_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BackBtn" Style="{StaticResource WikiHdrBtn}" Click="Back_Click" ToolTip="Back" IsEnabled="False">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource WikiHdrBtn}" Click="Reload_Click" ToolTip="Reload">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button x:Name="HomeBtn" Style="{StaticResource WikiHdrBtn}" Click="Home_Click" ToolTip="Wiki home">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Game wiki" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="12,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WikiHdrBtn}" Click="Search_Click" ToolTip="Search Fandom for this game">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource WikiHdrBtn}" Click="Close_Click" ToolTip="Close">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Address of the page, with a button that copies it. -->
            <Border Grid.Row="1" Background="#1B1F2A" Padding="12,0,10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Grid.Column="0" Style="{StaticResource UrlBox}" Height="30"
                             Text="" ToolTip="Address of this page"/>
                    <Button x:Name="CopyBtn" Grid.Column="1" Style="{StaticResource WikiHdrBtn}" Margin="6,0,0,0"
                            Click="CopyUrl_Click" ToolTip="Copy the address">
                        <TextBlock x:Name="CopyGlyph" Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="White"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Background="#101218">
                <wv2:WebView2 x:Name="Web"/>
                <TextBlock x:Name="StatusText" Text="" FontSize="14" Foreground="#9AA1B5" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24,0" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
