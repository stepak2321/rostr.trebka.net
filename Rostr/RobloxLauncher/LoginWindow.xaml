<Window x:Class="RobloxLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Add Roblox account" Width="520" Height="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ThBg}" Foreground="{DynamicResource ThText}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="16,12" FontSize="12" Foreground="{DynamicResource ThSoft}" TextWrapping="Wrap"
                   Text="Log in to the account you want to add. This window closes by itself once you are logged in. It uses a temporary browser profile, so it does not touch your normal browser."/>
        <wv2:WebView2 Grid.Row="1" x:Name="Web"/>
    </Grid>
</Window>
